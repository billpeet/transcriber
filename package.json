{
	"name": "transcriber",
	"productName": "Transcriber",
	"version": "0.1.0",
	"description": "Desktop app for transcribing and summarizing audio files",
	"private": true,
	"main": "dist-electron/main.cjs",
	"author": "billpeet",
	"repository": {
		"type": "git",
		"url": "https://github.com/billpeet/transcriber.git"
	},
	"scripts": {
		"dev": "concurrently -k -s first \"npm:dev:vite\" \"npm:dev:electron\"",
		"dev:vite": "vite --port 5173",
		"dev:electron": "node scripts/build-main.mjs && wait-on tcp:5173 && electron .",
		"build": "vite build && node scripts/build-main.mjs",
		"typecheck": "tsc --noEmit",
		"pack": "npm run build && electron-builder --win --dir",
		"dist": "npm run build && electron-builder --win",
		"release": "npm run build && electron-builder --win --publish always"
	},
	"dependencies": {
		"electron-updater": "^6.8.9",
		"ffmpeg-static": "^5.3.0",
		"ffprobe-static": "^3.1.0"
	},
	"devDependencies": {
		"@openrouter/ai-sdk-provider": "^2.3.3",
		"@tailwindcss/typography": "^0.5.19",
		"@types/node": "^25.9.3",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"ai": "^6.0.116",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"electron": "^42.4.0",
		"electron-builder": "^26.15.2",
		"esbuild": "^0.28.0",
		"lucide-react": "^0.577.0",
		"openai": "^6.32.0",
		"postcss": "^8.4.49",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-dropzone": "^15.0.0",
		"react-markdown": "^10.1.0",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2",
		"vite": "^6.0.3",
		"wait-on": "^9.0.10"
	}
}
